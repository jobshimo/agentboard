{
  "name": "@jobshimo/agentboard",
  "version": "0.1.0",
  "description": "Local-first task board for the human/agent loop — MCP server, Web UI, and CLI installer for Claude Code, OpenCode, and GitHub Copilot.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "agent",
    "task-board",
    "ai",
    "claude",
    "opencode",
    "copilot",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jobshimo/agentboard.git"
  },
  "bugs": {
    "url": "https://github.com/jobshimo/agentboard/issues"
  },
  "homepage": "https://github.com/jobshimo/agentboard#readme",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "agentboard": "dist/cli/index.js"
  },
  "packageManager": "pnpm@11.1.2",
  "files": [
    "dist/",
    "templates/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-migrations.mjs",
    "build:web": "vite build --config src/web/vite.config.ts",
    "dev:server": "tsx watch src/cli/index.ts",
    "dev:web": "vite dev --config src/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm build:web"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^8.3.1",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "better-sqlite3": "^11.6.0",
    "fastify": "^4.28.1",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.1"
  }
}
